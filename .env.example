# =============================================================================
# QAnubis — Environment Variables
# Copy this file to .env: cp .env.example .env
# For local development, all defaults below work after: docker compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Local dev:  postgresql://postgres:postgres@localhost:5432/qanubis
# Production: use your provider's connection string (e.g. Neon.tech)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qanubis"

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — optional, leave empty to disable Google login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth — optional, leave empty to disable GitHub login
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Object Storage (S3-compatible)
# Local dev:  MinIO via docker compose (UI at http://localhost:9001)
#   STORAGE_ENDPOINT="http://localhost:9000"
#   STORAGE_ACCESS_KEY="minioadmin"
#   STORAGE_SECRET_KEY="minioadmin"
#
# Cloudflare R2:
#   STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
#   STORAGE_REGION="auto"
#   STORAGE_ACCESS_KEY="<R2 Access Key ID>"
#   STORAGE_SECRET_KEY="<R2 Secret Access Key>"
#
# AWS S3:
#   STORAGE_ENDPOINT=""  (leave empty for AWS default)
#   STORAGE_REGION="us-east-1"
#   STORAGE_ACCESS_KEY="<AWS Access Key ID>"
#   STORAGE_SECRET_KEY="<AWS Secret Access Key>"
# -----------------------------------------------------------------------------
STORAGE_PROVIDER="s3"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="qanubis"

# -----------------------------------------------------------------------------
# Email (SMTP)
# Local dev:  MailHog via docker compose (UI at http://localhost:8025)
#   SMTP_HOST="localhost"
#   SMTP_PORT="1025"
#   SMTP_USER=""
#   SMTP_PASS=""
#
# Resend.com:
#   SMTP_HOST="smtp.resend.com"
#   SMTP_PORT="465"
#   SMTP_USER="resend"
#   SMTP_PASS="<Resend API Key>"
#
# Other SMTP providers (Brevo, Gmail, etc.):
#   SMTP_HOST="smtp.brevo.com"
#   SMTP_PORT="587"
#   SMTP_USER="<your login>"
#   SMTP_PASS="<your password>"
# -----------------------------------------------------------------------------
EMAIL_PROVIDER="nodemailer"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="QAnubis <noreply@qanubis.app>"

# -----------------------------------------------------------------------------
# OpenTelemetry / Distributed Tracing
# On Vercel: traces are sent automatically to Vercel Observability.
# Self-hosted / local dev: set OTEL_EXPORTER_OTLP_ENDPOINT to send traces to
# Jaeger, Grafana Tempo, or any OTLP-compatible backend.
#
# Example with Jaeger (docker run -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one):
#   OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# -----------------------------------------------------------------------------
# OTEL_SERVICE_NAME="qanubis"
# OTEL_EXPORTER_OTLP_ENDPOINT=""
