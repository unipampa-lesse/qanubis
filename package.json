{
	"name": "qanubis",
	"version": "1.1.0",
	"private": true,
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "next dev",
		"build": "prisma generate --config prisma/config.ts && next build",
		"analyze": "ANALYZE=true pnpm build",
		"start": "next start",
		"lint": "biome check --write",
		"lint:check": "biome check",
		"test": "vitest run",
		"postinstall": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs', 'public/pdf.worker.min.mjs')\"",
		"setup": "pnpm prisma:migrate && pnpm prisma:seed",
		"prisma:migrate": "prisma migrate dev --config prisma/config.ts",
		"prisma:seed": "tsx --env-file=.env prisma/seed.ts",
		"prisma:studio": "prisma studio --config prisma/config.ts",
		"prisma:generate": "prisma generate --config prisma/config.ts"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1030.0",
		"@aws-sdk/s3-request-presigner": "^3.1030.0",
		"@next-auth/prisma-adapter": "^1.0.7",
		"@observablehq/plot": "^0.6.17",
		"@prisma/adapter-pg": "^7.7.0",
		"@prisma/client": "^7.7.0",
		"@react-email/components": "^1.0.12",
		"@react-email/render": "^2.0.6",
		"@tailwindcss/postcss": "^4.2.2",
		"@tanstack/react-query": "^5.99.0",
		"@tiptap/react": "^3.22.3",
		"@tiptap/starter-kit": "^3.22.3",
		"@trpc/client": "^11.16.0",
		"@trpc/next": "^11.16.0",
		"@trpc/react-query": "^11.16.0",
		"@trpc/server": "^11.16.0",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.37.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"autoprefixer": "^10.5.0",
		"bcryptjs": "^3.0.3",
		"client-only": "^0.0.1",
		"clsx": "^2.1.1",
		"flatpickr": "^4.6.13",
		"highlight.js": "^11.11.1",
		"mermaid": "^11.14.0",
		"next": "^16.2.4",
		"next-auth": "^4.24.14",
		"nodemailer": "^8.0.5",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^5.6.205",
		"pg": "^8.20.0",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"react-icons": "^5.6.0",
		"react-markdown": "^10.1.0",
		"react-query": "^3.39.3",
		"rehype-highlight": "^7.0.2",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"server-only": "^0.0.1",
		"simplebar-react": "^3.3.2",
		"superjson": "^2.2.6",
		"swiper": "^12.1.3",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@next/bundle-analyzer": "^16.2.4",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.6",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@testing-library/react": "^16.3.2",
		"@types/bcryptjs": "^3.0.0",
		"@types/flatpickr": "^3.1.4",
		"@types/node": "^25.6.0",
		"@types/nodemailer": "^8.0.0",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"jsdom": "^29.0.2",
		"prisma": "^7.7.0",
		"semantic-release": "^25.0.3",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vitest": "^4.1.4"
	}
}
