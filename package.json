		"pg": "^8.20.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-icons": "^5.5.0",
		"react-query": "^3.39.3",
		"server-only": "^0.0.1",
		"simplebar-react": "^3.3.2",
		"superjson": "^2.2.6",
		"swiper": "^12.1.1",
